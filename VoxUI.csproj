<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        
        <Title>VoxUI</Title>
        <Description>Small immediate-mode UI system for Silk.NET.</Description>
        <PackageProjectUrl>https://github.com/Redvoxel-Games/VoxUI</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Redvoxel-Games/VoxUI</RepositoryUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>1.0.0</Version>
        <PackageTags>
            UI, GUI, Silk, Silk.NET, ImGui
        </PackageTags>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\"/>
        <None Include="../LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Open_Sans/static/OpenSans-Regular.ttf" />
        <EmbeddedResource Include="Assets/*.png" />
    </ItemGroup>
</Project>
