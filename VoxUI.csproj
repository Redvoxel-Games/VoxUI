<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
      <PackageReference Include="Silk.NET" Version="2.23.0" />
      <PackageReference Include="SixLabors.ImageSharp" Version="4.1.0" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Open_Sans/static/OpenSans-Regular.ttf" />
        <EmbeddedResource Include="Assets/*.png" />
    </ItemGroup>
</Project>
